# ---- Storage ----
# SQLite (default, zero setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://finagent:finagent@localhost:5432/finagent
DATABASE_URL=sqlite:///./data/finagent.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---- Business ----
CURRENCY=GBP
# Fallback when statement dates are ambiguous (03/04/2026): true = DD/MM, false = MM/DD
DATE_DAYFIRST=true

# ---- AI provider: ollama (free, local) | openai | anthropic | none ----
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=90
LLM_BATCH_SIZE=25

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Optional: read receipt photos directly, e.g. llama3.2-vision (empty = Tesseract OCR)
OLLAMA_VISION_MODEL=

# Optional paid providers (only used if LLM_PROVIDER is set to them)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Invoices & receipts ----
INVOICE_ALERT_DAYS=7
RECEIPT_MATCH_DAYS=5

# ---- API ----
CORS_ORIGINS=*
