# ---- Storage ----
# SQLite (default, zero setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://finagent:finagent@localhost:5432/finagent
DATABASE_URL=sqlite:///./data/finagent.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---- Business ----
BUSINESS_NAME=My Business
CURRENCY=USD
# First day of your tax year (MM-DD): 01-01 US/most countries, 04-06 UK, 07-01 Australia
TAX_YEAR_START=01-01
# Fallback when statement dates are ambiguous (03/04/2026): false = MM/DD (US), true = DD/MM
DATE_DAYFIRST=false

# ---- AI provider: ollama (free, local) | openai | anthropic | none ----
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=90
LLM_BATCH_SIZE=25

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Optional: read receipt photos directly, e.g. llama3.2-vision (empty = Tesseract OCR)
OLLAMA_VISION_MODEL=

# Optional paid providers (only used if LLM_PROVIDER is set to them)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Invoices & receipts ----
INVOICE_ALERT_DAYS=7
RECEIPT_MATCH_DAYS=5

# ---- Accounts ----
# local    = no login, one business (personal use on your own computer)
# accounts = login page, many businesses on one website (use this when hosting online)
AUTH_MODE=local
# Let anyone create an account on the login page (false = only you, via the CLI/existing users)
ALLOW_SIGNUP=true
# How long "stay logged in" lasts
SESSION_DAYS=30

# ---- Bank feeds (Plaid) ----
# Free sandbox keys: https://dashboard.plaid.com  → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake test banks, free) | production (real banks, needs Plaid approval)
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,CA
# Auto-sync connected banks every N hours (0 = only when you click Sync)
BANK_SYNC_HOURS=6
# Encrypts bank tokens at rest. Empty = auto-created in data/secret.key (BACK THIS FILE UP).
# Make one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- API ----
CORS_ORIGINS=*
