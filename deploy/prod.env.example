# Copy to prod.env and fill in. Never commit prod.env.

# Your web address. Point its DNS "A record" at the server's IP first.
DOMAIN=books.example.com

# Long random password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts bank tokens. Make one with:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Keep a copy somewhere safe — without it, connected banks must be re-linked.
ENCRYPTION_KEY=

# Who can sign up: true = anyone with the link, false = existing users only
ALLOW_SIGNUP=true
SESSION_DAYS=30

# Defaults for new businesses (each business can change these in Settings)
CURRENCY=USD
TAX_YEAR_START=01-01
DATE_DAYFIRST=false

# AI categorizing. On a small server use a paid API (cheap) or none.
LLM_PROVIDER=none
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Bank feeds (optional). Sandbox = test banks; production needs Plaid approval.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,CA
BANK_SYNC_HOURS=6
